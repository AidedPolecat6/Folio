<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Folio.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <PathMap>$(MSBuildProjectDirectory)=/_/Folio</PathMap>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="159.0.8138" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Folio.ico" />
    <Content Include="Assets\Folio.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Folio.png;docs\images\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.md;licenses\**\*;README.md;LICENSE;docs\USER-GUIDE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
